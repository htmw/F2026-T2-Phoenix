{
  "uid": "agentorch-cost",
  "title": "Agent orchestration — cost and reliability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["agentorch"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Estimated spend (this process)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "agentorch_cost_usd_total", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Retries",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "agentorch_retries_total", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Input tokens",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "agentorch_input_tokens_total", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Output tokens",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "agentorch_output_tokens_total", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Executions by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (agentorch_executions_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Provider failures",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider) (agentorch_provider_failures_total)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ]
    }
  ]
}
