# ---- Secrets: never commit real env files ----
# Local secrets live in `.env` only (copy from `.env.example`).
.env
.env.local
.env.*.local
# Accidental double-extension / misnamed copies
.env.example.env
.env.env
*.pem
*.key
secrets/

# Keep the committed template:
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage*
coverage.xml
htmlcov/

# ---- Node / Next.js ----
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
playwright-report/
test-results/
blob-report/
playwright/.cache/

