# Copy to .env and fill in. NEVER commit .env.
# Provider keys are read by the backend only and are never sent to the frontend.

# ---- Application ----
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console          # console | json

# ---- PostgreSQL (durable state) ----
POSTGRES_USER=agentorch
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=agentorch
POSTGRES_PORT=5432
# Host-based runs use localhost; docker compose overrides the host to "postgres".
DATABASE_URL=postgresql+asyncpg://agentorch:change-me-locally@localhost:5432/agentorch

# ---- Redis (queues, cache, locks; NOT source of truth) ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- Frontend ----
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Browser-visible base URL. Must not contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side (container-to-container) base URL used by Next.js server components.
BACKEND_INTERNAL_URL=http://backend:8000

# ---- Auth foundations (Universal Office Sprint 9) ----
# header = require X-Operator-Id or Authorization: Bearer <id>
# off = use DEV_OPERATOR_ID when no header (local scripts / some tests)
# Production forbids AUTH_MODE=off.
AUTH_MODE=header
DEV_OPERATOR_ID=operator

# ---- Abuse protection (Universal Office Sprint 10) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis          # redis | memory
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Soft rolling spend cap per operator (USD). Leave empty for unlimited.
OPERATOR_BUDGET_USD=
OPERATOR_BUDGET_WINDOW_HOURS=24

# ---- CORS / hosts ----
CORS_ALLOW_ORIGINS=http://localhost:3000
# Production: comma-separated Host allow-list (no '*')
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- AI provider API keys (backend only; optional — also connectable in Settings) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
QWEN_API_KEY=
# Hugging Face Inference Providers (Hub token with Inference Providers permission).
# HF_TOKEN is also accepted as an alias.
HUGGINGFACE_API_KEY=

# Symmetric key for encrypting Settings-managed provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Development derives a fallback when unset.
ENCRYPTION_KEY=

# HS256 secret for Authorization: Bearer JWTs (claim ``sub`` = operator id).
# Required in production. Office UI still uses X-Operator-Id without a JWT.
JWT_SECRET=
# Optional JWT claim checks (leave empty to skip):
JWT_AUDIENCE=
JWT_ISSUER=
